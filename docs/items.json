{%- comment -%} Every verified entry, awards included. {%- endcomment -%}
{%- assign all_items = site.data.publications | concat: site.data.working_papers | concat: site.data.editos | concat: site.data.media | concat: site.data.talks | concat: site.data.projects | concat: site.data.awards | where: "verified", true | sort: "date" | reverse -%}
{
  "generated": {{ site.time | date: "%Y-%m-%d" | jsonify }},
  "count": {{ all_items.size }},
  "items": {{ all_items | jsonify }}
}
